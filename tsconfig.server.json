{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["bun", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "server",
    "src/lib/validationRules.ts",
    "src/lib/engines.ts",
    "src/types.ts",
    // Client-side pure helpers and their bun tests: `bun test` runs them, so they
    // need the bun types the client config deliberately does not carry.
    "src/lib/format.ts",
    "src/lib/format.test.ts"
  ]
}
