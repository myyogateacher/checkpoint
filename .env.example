# ── Frontend (build-time — baked into the bundle by Vite) ────────────────────
# Base URL for API calls. Leave blank when the SPA is served by the same server.
VITE_API_BASE_URL=

# Show the email/password login & signup forms. Set to "false" to offer
# Google sign-in only. Defaults to enabled when unset.
VITE_ENABLE_PASSWORD_AUTH=true

# Single-tenant lock. When set, this org is created automatically, every user
# belongs to it, and no other organizations can be created. Leave unset for
# multi-tenant mode (users create/join their own organizations).
VITE_ORG=

# Google client id for the in-browser Google Identity Services button.
VITE_GOOGLE_CLIENT_ID=

# ── Backend (runtime) ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Public origin used to build password-reset links (defaults to the request origin).
APP_BASE_URL=

# Session cookie signing secret (stable across restarts).
SESSION_SECRET=change-me
# Encryption key for stored connection/SMTP secrets (defaults to SESSION_SECRET).
APP_SECRET_KEY=

# Google: the server verifies the ID token the client sends against this id.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MySQL metadata store (the app's own database). Either APP_DATABASE_URL …
APP_DATABASE_URL=mysql://checkpoint:checkpoint@localhost:3306/checkpoint
# … or the individual parts (used if APP_DATABASE_URL is unset):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=checkpoint
# DB_PASSWORD=checkpoint
# DB_NAME=checkpoint
# for local development
CORS_ORIGINS=https://localhost:3000
CROSS_SITE_COOKIES=true

# ── Redshift replica reload (optional) ───────────────────────────────────────
# Full ARN of the MySQL -> Redshift DMS task. Unset disables the feature: no notice
# on the migration form and no reload after apply. The region is read from the ARN.
DMS_TASK_ARN=
# AWS credentials are read by the SDK's default provider chain, not by Checkpoint.
# On an EC2 instance or ECS task with an IAM role attached, leave these unset and the
# role is used. Anywhere else, set them. The role or user needs only
# dms:DescribeTableStatistics and dms:ReloadTables on the task above.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# The MySQL schema that task replicates. A migration only triggers a reload when its
# write connection points at this schema.
DMS_SOURCE_SCHEMA=
# Set to false to only warn and notify instead of reloading. Note a reload re-runs
# the full load, and the task's TargetTablePrepMode decides whether the Redshift
# table is emptied or dropped for that window.
DMS_AUTO_RELOAD=true
# Channel for reload notifications; falls back to the org's configured Slack channel.
DMS_SLACK_CHANNEL=
# Poll DMS every five minutes for tables that fell out of the replica. On unless set
# to false: the migration hook cannot tell whether its own reload worked, and this is
# what closes that loop. It also catches drift from a manual ALTER or another tool.
DMS_WATCH_ENABLED=true
# Minutes an attempt is given to take effect before the table counts as still broken.
DMS_RETRY_GRACE_MINUTES=30
# When a reload does not fix a table, its Redshift copy has to be dropped so the next
# reload recreates it with the current schema. Checkpoint can do that itself via the
# connection below, but it is destructive, so it is opt-in. Left off, the drop is
# described in Slack for a human instead.
DMS_ALLOW_DROP=false

# Redshift target, used only to drop a table whose schema has drifted. Leave the host
# empty and the drop is described in Slack rather than performed.
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
# Redshift refuses plaintext on most clusters, so this defaults to true.
REDSHIFT_SSL=true
